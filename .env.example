# ─── Neon Auth (Managed Better Auth) ───
# Console → Project → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ─── Neon Postgres (pooled connection string) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
CLOUDINARY_PROFILE_FOLDER=nodoseoff/profiles

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Resend (https://resend.com/api-keys) — transactional mail (welcome, drug updates)
RESEND_API_KEY=
# After you verify a domain in Resend, set e.g. NoDoseOff <hello@yourdomain.com>
# Until then onboarding@resend.dev only delivers to your Resend account email.
RESEND_FROM_EMAIL=NoDoseOff <onboarding@resend.dev>
# Optional: Resend Audience/Segment ID for newsletter Broadcasts
# Create at https://resend.com/audiences then paste the id here
RESEND_AUDIENCE_ID=

# ─── Admin allowlist (comma-separated emails) ───
ADMIN_EMAILS=hadesanoye01@gmail.com,nodoseoff@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=hadesanoye01@gmail.com,nodoseoff@gmail.com

# ─── AI ───
# Google Gemini (preferred)
GOOGLE_GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallbacks:
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# Neon AI Gateway (paid Neon plan only):
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=
# AI_PROVIDER=gemini

