# ─── Neon Auth (Managed Better Auth) ───
# Console → Project → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ─── Neon Postgres (pooled connection string) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
CLOUDINARY_PROFILE_FOLDER=nodoseoff/profiles

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra browser origins allowed for auth POSTs (comma-separated).
# nodoseoff.com / www / vercel.app / localhost are included by default.
# AUTH_TRUSTED_ORIGINS=https://staging.example.com
# Origin sent upstream to misty-boat Neon Auth (must be localhost*).
# NEON_AUTH_UPSTREAM_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Resend (https://resend.com/api-keys) — welcome + dose reminders + drug updates
RESEND_API_KEY=
# After you verify nodoseoff.com in Resend, set:
# RESEND_FROM_EMAIL=NoDoseOff <hello@nodoseoff.com>
# Until then onboarding@resend.dev only delivers to your Resend account email.
RESEND_FROM_EMAIL=NoDoseOff <onboarding@resend.dev>
# Optional: Resend Audience/Segment ID for newsletter Broadcasts
# Create at https://resend.com/audiences then paste the id here
RESEND_AUDIENCE_ID=
# email now; set to push when the mobile app ships
NOTIFICATION_CHANNEL=email
NOTIFICATIONS_ENABLED=true
# Timezone for the daily 6am morning dose digest (IANA)
# Vercel cron runs in UTC: Africa/Lagos 06:00 = 05:00 UTC (vercel.json)
DOSE_REMINDER_TIMEZONE=Africa/Lagos
# Protects /api/cron/* (also used by Vercel Cron Authorization header)
CRON_SECRET=

# ─── Admin allowlist (comma-separated emails) ───
ADMIN_EMAILS=hadesanoye01@gmail.com,nodoseoff@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=hadesanoye01@gmail.com,nodoseoff@gmail.com

# ─── AI ───
# Google Gemini (preferred)
GOOGLE_GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional AMANDA spoken answers (Gemini TTS — lite is fastest):
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Aoede
# Optional fallbacks:
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# Neon AI Gateway (paid Neon plan only):
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=
# AI_PROVIDER=gemini

